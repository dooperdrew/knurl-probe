# Knurl Probe: texts written in Rust (the t! macro, src/i18n.rs), in Spanish.
# Read into the exe at build time. msgid is the English text in the code;
# keep every {name} as it is. src/i18n.rs tests fail when a text used in
# the code is missing here or a translation loses a {name}.
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Asking for the model, firmware and features"
msgstr "Preguntando el modelo, el firmware y las funciones"

msgid "Battery"
msgstr "Batería"

msgid "Check that the headphones are on and connected to this PC, then check again."
msgstr "Comprueba que los auriculares estén encendidos y conectados a este PC y vuelve a comprobar."

msgid "Control service"
msgstr "Servicio de control"

msgid "Features declared"
msgstr "Funciones declaradas"

msgid "Firmware"
msgstr "Firmware"

msgid "Knurl already supports your {model}"
msgstr "Knurl ya es compatible con tus {model}"

msgid "Knurl does not know the {model} yet. Send the report and it can be added."
msgstr "Knurl aún no conoce los {model}. Envía el informe y se podrán añadir."

msgid "Listening on the newer Sony service"
msgstr "Escuchando en el servicio de Sony más reciente"

msgid "MDR v1 and MDR v2"
msgstr "MDR v1 y MDR v2"

msgid "MDR v2 (newer)"
msgstr "MDR v2 (más reciente)"

msgid "Model"
msgstr "Modelo"

msgid "New model: thank you"
msgstr "Modelo nuevo: gracias"

msgid "Nothing could be read"
msgstr "No se ha podido leer nada"

msgid "Opening the control channel"
msgstr "Abriendo el canal de control"

msgid "Protocol"
msgstr "Protocolo"

msgid "Putting the report together"
msgstr "Preparando el informe"

msgid "Sending the report still helps: it confirms the model with your firmware."
msgstr "Enviar el informe sigue ayudando: confirma el modelo con tu firmware."

msgid "They answered on MDR v2, which Knurl cannot read yet. The report recorded what they sent: sending it helps to add them."
msgstr "Han respondido en MDR v2, que Knurl aún no sabe leer. El informe ha registrado lo que enviaron: enviarlo ayuda a añadirlos."

msgid "Windows did not give the Documents folder: {e}"
msgstr "Windows no ha indicado la carpeta Documentos: {e}"

msgid "Your headphones use the newer Sony service"
msgstr "Tus auriculares usan el servicio de Sony más reciente"

msgid "could not create {path}: {e}"
msgstr "no se ha podido crear {path}: {e}"

msgid "could not write {path}: {e}"
msgstr "no se ha podido escribir {path}: {e}"

msgid "headphones"
msgstr "auriculares"

msgid "reports to Knurl Probe are switched off for now"
msgstr "por ahora los informes a Knurl Probe están desactivados"

msgid "the Documents folder name is not valid: {e}"
msgstr "el nombre de la carpeta Documentos no es válido: {e}"

msgid "the report is too large for the server"
msgstr "el informe es demasiado grande para el servidor"

msgid "the report is {length} characters, more than the {limit} the server takes: save it to a file and attach it to an issue instead"
msgstr "el informe tiene {length} caracteres, más de los {limit} que acepta el servidor: guárdalo en un archivo y adjúntalo a una issue"

msgid "the server answered HTTP {status}"
msgstr "el servidor ha respondido HTTP {status}"

msgid "the server answered HTTP {status} ({reason})"
msgstr "el servidor ha respondido HTTP {status} ({reason})"

msgid "the server answered {status} without an issue number: it is unclear whether the report arrived"
msgstr "el servidor ha respondido {status} sin número de issue: no está claro si el informe ha llegado"

msgid "the server could not be reached: {reason}"
msgstr "no se ha podido contactar con el servidor: {reason}"

msgid "the server could not reach GitHub: try again later"
msgstr "el servidor no ha podido contactar con GitHub: inténtalo más tarde"

msgid "the server does not accept reports from Knurl Probe yet"
msgstr "el servidor aún no acepta informes de Knurl Probe"

msgid "the server does not know this app's key"
msgstr "el servidor no reconoce la clave de esta app"

msgid "the server refused the report ({reason})"
msgstr "el servidor ha rechazado el informe ({reason})"

msgid "there is no report to save"
msgstr "no hay ningún informe que guardar"

msgid "there is no report to send"
msgstr "no hay ningún informe que enviar"

msgid "too many reports were sent in the last hour: try again later"
msgstr "se han enviado demasiados informes en la última hora: inténtalo más tarde"

msgid "internal error: {e}"
msgstr "error interno: {e}"

msgid "Knurl Probe stopped: {e}"
msgstr "Knurl Probe se detuvo: {e}"

msgid "Could not open {target}: {e}"
msgstr "No se pudo abrir {target}: {e}"

msgid "Could not open the folder: {e}"
msgstr "No se pudo abrir la carpeta: {e}"
