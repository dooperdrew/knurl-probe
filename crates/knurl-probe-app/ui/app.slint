// Knurl Probe: five screens in one window (design/README.md, screens).
// Rust fills every value from the flow (src/view.rs); the screens only show
// them and report clicks.
import { AboutSlint, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    BrandButton, BrandSpinner, Card, KnobMark, LinkText, Notice, SearchBar, StrokeIcon,
} from "components.slint";

export { Palette }

// One step of the check: 0 waiting, 1 running, 2 done, 3 not offered.
export struct StepRow {
    label: string,
    state: int,
}

// One line of "what was read".
export struct Fact {
    label: string,
    value: string,
}

// Tick in a circle (done step) and the empty circle (waiting step).
component StepMark inherits Rectangle {
    in property <int> state;
    width: 20px;
    height: 20px;
    if root.state == 1: BrandSpinner { size: 20px; }
    if root.state != 1: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: root.state == 2 ? Theme.ok : Theme.control;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.state == 2 ? "M 3 10 A 7 7 0 1 1 17 10 A 7 7 0 1 1 3 10 M 6.5 10.2 L 9 12.6 L 13.6 7.6"
            : root.state == 3 ? "M 3 10 A 7 7 0 1 1 17 10 A 7 7 0 1 1 3 10 M 7 10 L 13 10"
            : "M 3 10 A 7 7 0 1 1 17 10 A 7 7 0 1 1 3 10";
    }
}

// The title of a screen and the line under it.
component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: 20px;
        font-weight: 600;
        color: Theme.ink;
        wrap: word-wrap;
    }
    if root.text != "": Text {
        text: root.text;
        font-size: 13px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

// A row of the "what it sends" lists on the welcome screen.
component Bullet inherits HorizontalLayout {
    in property <string> text;
    in property <bool> never;
    spacing: 8px;
    StrokeIcon {
        width: 16px;
        height: 16px;
        colour: root.never ? Theme.muted : Theme.ok;
        d: root.never ? "M 6 6 L 18 18 M 18 6 L 6 18" : "M 5 12.5 L 10 17 L 19 7";
    }
    Text {
        text: root.text;
        font-size: 13px;
        color: Theme.ink;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component MainWindow inherits Window {
    title: @tr("Knurl Probe");
    icon: @image-url("../../../design/icons/app-icon-small.svg");
    default-font-family: "Segoe UI";
    background: Theme.surface;
    width: 440px;
    height: 660px;

    // 0 welcome, 1 choose, 2 checking, 3 result, 4 send.
    in property <int> page;

    // Choose: 0 searching, 1 found, 2 none, 3 failed.
    in property <int> search-state;
    in property <[string]> devices;
    in property <string> search-error;

    // Checking.
    in property <string> device-name;
    in property <[StepRow]> steps;

    // Result: 0 supported, 1 new model, 2 not decoded, 3 nothing read.
    in property <int> result-kind;
    in property <string> result-title;
    in property <string> result-text;
    in property <[Fact]> facts;
    in property <[string]> problems;

    // Send.
    in property <bool> show-data;
    in property <string> data;
    in property <string> saved-path;
    in property <string> save-error;
    // The report is over the relay's limit: it can only be saved.
    in property <bool> too-long;
    // 0 idle, 1 sending, 2 sent, 3 not sent.
    in property <int> send-state;
    in property <string> send-error;
    in property <string> issue-url;

    in property <string> version;

    callback begin();
    callback search-again();
    callback choose(int);
    callback open-bluetooth-settings();
    callback check-again();
    callback to-send();
    callback toggle-data();
    callback save();
    callback send();
    callback open-issue();
    callback show-in-folder();
    callback open-issue-form();
    callback back();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header: the mark, the name, and Back where there is one.
        HorizontalLayout {
            spacing: 10px;
            KnobMark { size: 24px; }
            Text {
                text: @tr("Knurl Probe");
                font-size: 14px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.page == 1 || root.page == 3 || (root.page == 4 && root.send-state != 1): LinkText {
                text: @tr("Back");
                clicked => { root.back(); }
            }
        }

        // 1. Welcome.
        if root.page == 0: VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Heading {
                title: @tr("Help Knurl learn your headphones");
                text: @tr("Knurl Probe asks your Sony headphones a few read-only questions and prepares a short report, so Knurl can support your model. Nothing on the headphones changes.");
            }
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: @tr("The report holds"); font-size: 13px; font-weight: 600; color: Theme.ink; }
                    Bullet { text: @tr("the model, the firmware and the features the headphones declare"); }
                    Bullet { text: @tr("the bytes they exchanged with this PC during the check"); }
                    Bullet { text: @tr("the Windows version"); }
                    Text { text: @tr("It never holds"); font-size: 13px; font-weight: 600; color: Theme.ink; }
                    Bullet { never: true; text: @tr("the Bluetooth address of your headphones"); }
                    Bullet { never: true; text: @tr("the name of this PC or your user name"); }
                    Bullet { never: true; text: @tr("a name you gave your headphones"); }
                }
            }
            HorizontalLayout {
                alignment: start;
                BrandButton {
                    text: @tr("Start");
                    primary: true;
                    clicked => { root.begin(); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            // The attribution the Slint licence asks for, on the first
            // screen; small, so the app stays the subject.
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    alignment: end;
                    spacing: 4px;
                    Text { text: @tr("Built with:"); font-size: 12px; color: Theme.muted; }
                    AboutSlint { max-width: 110px; max-height: 56px; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: end;
                    Text {
                        text: @tr("Version {}. Not affiliated with Sony.", root.version);
                        font-size: 12px;
                        color: Theme.muted;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        // 2. Choose your headphones.
        if root.page == 1: VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Heading {
                title: @tr("Choose your headphones");
                text: root.search-state == 0 ? @tr("Looking for Sony headphones paired with this PC. Keep them on and close by.")
                    : root.search-state == 1 ? @tr("The Sony headphones paired with this PC. The name is the one Windows shows; it stays on this PC.")
                    : "";
            }
            if root.search-state == 0: SearchBar { }
            if root.search-state == 1: VerticalLayout {
                spacing: 8px;
                for name[i] in root.devices: Card {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        StrokeIcon {
                            width: 20px;
                            height: 20px;
                            d: "M 4 14 L 4 12 A 8 8 0 0 1 20 12 L 20 14 M 4 14 L 4 18 A 1 1 0 0 0 5 19 L 7 19 L 7 13 L 5 13 A 1 1 0 0 0 4 14 M 20 14 L 20 18 A 1 1 0 0 1 19 19 L 17 19 L 17 13 L 19 13 A 1 1 0 0 1 20 14";
                        }
                        Text {
                            text: name;
                            font-size: 14px;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        BrandButton {
                            text: @tr("Check");
                            primary: true;
                            clicked => { root.choose(i); }
                        }
                    }
                }
            }
            if root.search-state == 2: Notice {
                kind: 2;
                title: @tr("No Sony headphones found");
                text: @tr("Turn your headphones on and pair them in the Windows Bluetooth settings (the entry without LE_), then search again.");
            }
            if root.search-state == 3: Notice {
                kind: 0;
                title: @tr("Windows could not list the Bluetooth devices");
                text: root.search-error;
            }
            if root.search-state >= 2: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                BrandButton {
                    text: @tr("Search again");
                    primary: true;
                    clicked => { root.search-again(); }
                }
                BrandButton {
                    text: @tr("Open Bluetooth settings");
                    clicked => { root.open-bluetooth-settings(); }
                }
            }
            if root.search-state == 1: HorizontalLayout {
                alignment: start;
                LinkText {
                    text: @tr("Not in the list? Search again");
                    clicked => { root.search-again(); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // 3. Checking.
        if root.page == 2: VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Heading {
                title: @tr("Checking your {}", root.device-name);
                text: @tr("This takes up to half a minute. The questions are read-only: nothing on the headphones changes.");
            }
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    for step in root.steps: HorizontalLayout {
                        spacing: 10px;
                        StepMark { state: step.state; }
                        Text {
                            text: step.state == 3 ? @tr("{} (not offered by these headphones)", step.label) : step.label;
                            font-size: 13px;
                            color: step.state == 0 || step.state == 3 ? Theme.muted : Theme.ink;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // 4. Result, in plain words.
        if root.page == 3: VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;
            Heading {
                title: root.result-title;
                text: root.result-text;
            }
            if root.facts.length > 0: Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: @tr("What was read"); font-size: 13px; font-weight: 600; color: Theme.ink; }
                    for fact in root.facts: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: fact.label;
                            font-size: 13px;
                            color: Theme.muted;
                            min-width: 130px;
                            max-width: 130px;
                        }
                        Text {
                            text: fact.value;
                            font-size: 13px;
                            color: Theme.ink;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            for problem in root.problems: Notice {
                kind: 0;
                title: @tr("Problem");
                text: problem;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                BrandButton {
                    text: @tr("Next");
                    primary: true;
                    clicked => { root.to-send(); }
                }
                BrandButton {
                    text: @tr("Check again");
                    clicked => { root.check-again(); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // 5. Send.
        if root.page == 4: VerticalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            Heading {
                title: @tr("Send the report");
                text: root.too-long ? @tr("This report is too long to send from the app. Save it and attach it to a \"New headphone model\" issue on GitHub.")
                    : @tr("Send opens an issue in the Knurl Probe repository on GitHub with this report. You need no GitHub account. See first exactly what leaves this PC.");
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                BrandButton {
                    // Disabled while sending and once sent: one report, one issue.
                    text: root.send-state == 1 ? @tr("Sending...") : @tr("Send");
                    primary: true;
                    enabled: !root.too-long && (root.send-state == 0 || root.send-state == 3);
                    clicked => { root.send(); }
                }
                BrandButton {
                    text: @tr("Save to a file");
                    clicked => { root.save(); }
                }
                BrandButton {
                    text: root.show-data ? @tr("Hide the data") : @tr("See what will be sent");
                    clicked => { root.toggle-data(); }
                }
            }
            if root.send-state == 2: Notice {
                kind: 2;
                title: @tr("Sent. Thank you!");
                text: @tr("The report is now an issue on GitHub: {}", root.issue-url);
                action: @tr("Open the issue");
                action-clicked => { root.open-issue(); }
            }
            if root.send-state == 3: Notice {
                kind: 0;
                title: @tr("Not sent");
                text: root.send-error;
                action: @tr("Try again");
                action-clicked => { root.send(); }
            }
            if root.saved-path != "": Notice {
                kind: 2;
                title: @tr("Saved");
                text: root.saved-path;
                action: @tr("Show in folder");
                action-clicked => { root.show-in-folder(); }
            }
            if root.save-error != "": Notice {
                kind: 0;
                title: @tr("The report was not saved");
                text: root.save-error;
                action: @tr("Try again");
                action-clicked => { root.save(); }
            }
            HorizontalLayout {
                alignment: start;
                LinkText {
                    text: @tr("Open the \"New headphone model\" form on GitHub");
                    clicked => { root.open-issue-form(); }
                }
            }
            if root.show-data: Rectangle {
                vertical-stretch: 1;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 8px;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    content-width: data-text.preferred-width + 24px;
                    content-height: data-text.preferred-height + 24px;
                    data-text := Text {
                        x: 12px;
                        y: 12px;
                        text: root.data;
                        font-family: "Consolas";
                        font-size: 11px;
                        color: Theme.ink;
                    }
                }
            }
            if !root.show-data: Rectangle { vertical-stretch: 1; }
        }
    }
}
